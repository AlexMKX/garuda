EXTERNAL_URL={{ fz_server_url }}
DEFAULT_ADMIN_EMAIL={{ fz_admin }}
FZ_INSTALL_DIR={{ fz_firezone_dir }}
DEFAULT_ADMIN_PASSWORD={{ fz_admin_password }}
WIREGUARD_IPV4_NETWORK={{fz_client_subnet}}
WIREGUARD_IPV4_ADDRESS={{fz_client_subnet| ansible.utils.ipaddr('1')| ansible.utils.ipaddr('address')}}
FZ_PORT=13000
WIREGUARD_PORT={{fz_wireguard_port}}
PHOENIX_SECURE_COOKIES={{ fz_firezone_https | lower }}
# Firezone built-in egress masquerade — driven by `fz_masquerade` (default false
# in Garuda topologies). When false, source-IP transparency is preserved end
# to end so ipt_server pinning portal, OSPF transit and conntrack observability
# see the real client tunnel IP instead of a backbone proxy. SNAT must then be
# owned exclusively by the border bridge (oifname "border" masquerade in the
# wireguard role's postup.sh). Stand-alone deployments without that border
# chain MUST set fz_masquerade=true — see roles/firezone/defaults/main.yml.
WIREGUARD_IPV4_MASQUERADE={{ fz_masquerade | bool | lower }}
WIREGUARD_IPV6_MASQUERADE={{ fz_masquerade | bool | lower }}
