# ipt_server stack
{% set _nets = (ipt_nic_attach | default('["backbone"]')) | compose_networks %}
services:
  garuda_ipt:
    restart: always
    image: {{ ipt_server_image }}
    cap_add:
      - NET_ADMIN
    networks:
      ipt_server_net:
{{ _nets.service | to_nice_yaml(indent=2) | indent(6, true) }}
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.rp_filter=2
    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1:8888"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 300s
    volumes:
      - ipt_server_data:/data
    env_file:
      - .env
{% if ipt_server_labels | default({}) | length > 0 %}
    labels:
{% for label_key, label_value in (ipt_server_labels | default({}) | dictsort) %}
      {{ label_key | tojson }}: {{ label_value | tojson }}
{% endfor %}
{% endif %}

  garuda_pdns:
    restart: always
    image: {{ ipt_powerdns_image }}
    networks:
      ipt_server_net:
    healthcheck:
      test: ["CMD-SHELL", "rec_control ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    depends_on:
      garuda_ipt:
        condition: service_healthy

networks:
  ipt_server_net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.31.0.0/24
{{ _nets.stack | to_nice_yaml(indent=2) | indent(2, true) }}

volumes:
  ipt_server_data:
