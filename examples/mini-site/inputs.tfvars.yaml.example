# Sanitized variable template for the mini-site reference example.
# Copy this file, rename it to inputs.tfvars.yaml (or your SOPS-encrypted
# equivalent), and replace every placeholder value before running terragrunt.
#
# All domain names use example.net.
# All IP addresses use RFC 5737 documentation ranges:
#   192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24

base_domain: example.net
env_slug: mini-site

hub:
  fqdn_prefix: hub
  machine_type: example-small

edges:
  usa:
    fqdn_prefix: usa
    hub_cidr: 192.0.2.1/28
    peer_cidr: 192.0.2.2/28
    listen_port: 51820
    ospf_router_id_hub: 192.0.2.10
    ospf_router_id_peer: 192.0.2.11

hub_ros:
  hub_cidr: 198.51.100.1/28
  routeros_cidr: 198.51.100.2/28
  listen_port: 51821
  ospf_router_id_hub: 198.51.100.10
  ospf_router_id_peer: 198.51.100.11

routeros:
  hostname: routeros-example
  management_host: 203.0.113.10
  user: admin
  uplink_interface: ether1

operator_ssh_keys:
  - "operator:ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample operator@example"

# Additional routes for ipt_server. Each entry is a list(string) with type
# inference: CIDR -> net rule, ISO country code -> geo rule, regex -> domain rule.
ipt_routes_germany_nets: []
